VITE_API_BASE_URL=

# Feature flags (see src/shared/config/flags.ts). Set to "true" to enable.
# Kanban drag-&-drop order stage changes — backend endpoint POST /orders/{id}/status is live.
VITE_FEATURE_ORDERS_DND=true
# Order editing — PATCH /orders/{id} is live (edits `notes`; status routes via
# /orders/{id}/status to keep history; cancellation via /orders/{id}/cancel).
VITE_FEATURE_ORDER_EDITING=true
